-->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">
	<Script file="CoordsTracking_Options.lua"/>
	<Frame name="CoordsTrackingOptionsFrame" hidden="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontNormalLarge" text="CRDS_OPTION_TITLE">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="15" y="-15"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<CheckButton name="$parent_ShowOnScreen" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="20" y="-45"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(CRDS_OPT_SHOWONSCREEN);
					</OnLoad>
					<OnClick>
						CoordsTrackingOptions_ShowOnScreenToggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_ShowZoneName" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_ShowOnScreen" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="20" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(CRDS_OPT_SHOWZONENAME);
					</OnLoad>
					<OnClick>
						CoordsTrackingOptions_ShowZoneNameToggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_ShowZoneNameTooltip" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_ShowZoneName" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(CRDS_OPT_SHOWZONENAMETOOLTIP);
					</OnLoad>
					<OnClick>
						CoordsTrackingOptions_ShowZoneNameTooltipToggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_ShowOnWorldMap" inherits="InterfaceOptionsSmallCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_ShowZoneNameTooltip" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="-20" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(CRDS_OPT_SHOWONWORLDMAP);
					</OnLoad>
					<OnClick>
						CoordsTrackingOptions_ShowOnWorldMapToggle();
					</OnClick>
				</Scripts>
			</CheckButton>
			<Button name="$parent_ResetPosition" inherits="OptionsButtonTemplate" text="CRDS_OPT_BTN_RESET">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_ShowOnScreen" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="400" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension x="160" y="21" />
				</Size>
				<Scripts>
					<OnClick>
						CoordsTrackingOptions_ResetPosition();
					</OnClick>
				</Scripts>
			</Button>
			<Slider name="$ParentSliderAccuracy" inherits="OptionsSliderTemplate">
				<Size>
					<AbsDimension x="360" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_ShowOnWorldMap" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="100" y="-50" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:EnableMouseWheel(true)
						CoordsTrackingOptions_SetupSlider(self, CRDS_OPT_ACCURACY, 0, 2.0, 1.0);
						CoordsTrackingOptionsFrameSliderAccuracyLow:SetText("0.00");
						CoordsTrackingOptionsFrameSliderAccuracyHigh:SetText("2.00");
					</OnLoad>
					<OnValueChanged>
						CoordsTrackingOptions_SliderAccuracyOnValueChanged(self);
					</OnValueChanged>
					<OnMouseWheel>
						CoordsTrackingOptions_OnMouseWheel(self, delta)
					</OnMouseWheel>
				</Scripts>
			</Slider>
			<Slider name="$ParentSliderAlpha" inherits="OptionsSliderTemplate">
				<Size>
					<AbsDimension x="360" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$ParentSliderAccuracy" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="-50" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:EnableMouseWheel(true)
						CoordsTrackingOptions_SetupSlider(self, CRDS_OPT_TRANSPARENCY, 0, 1.0, 0.01);
						CoordsTrackingOptionsFrameSliderAlphaLow:SetText("0.00");
						CoordsTrackingOptionsFrameSliderAlphaHigh:SetText("1.00");
					</OnLoad>
					<OnValueChanged>
						CoordsTrackingOptions_SliderAlphaOnValueChanged(self);
					</OnValueChanged>
					<OnMouseWheel>
						CoordsTrackingOptions_OnMouseWheel(self, delta)
					</OnMouseWheel>
				</Scripts>
			</Slider>
			<Slider name="$ParentSliderToolTipScale" inherits="OptionsSliderTemplate">
				<Size>
					<AbsDimension x="360" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$ParentSliderAlpha" relativePoint="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="-50" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:EnableMouseWheel(true)
						CoordsTrackingOptions_SetupSlider(self, CRDS_OPT_TOOLTIPSCALE, 0.01, 1.75, 0.01);
						CoordsTrackingOptionsFrameSliderToolTipScaleLow:SetText("0.01");
						CoordsTrackingOptionsFrameSliderToolTipScaleHigh:SetText("1.75");
					</OnLoad>
					<OnValueChanged>
						CoordsTrackingOptions_SliderToolTipScaleOnValueChanged(self)
					</OnValueChanged>
					<OnMouseWheel>
						CoordsTrackingOptions_OnMouseWheel(self, delta)
					</OnMouseWheel>
				</Scripts>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad>
				CoordsTrackingOptions_OnLoad(self);
			</OnLoad>
			<OnShow>
				CoordsTrackingOptions_OnShow(self);
			</OnShow>
			<OnHide>
				CoordsTrackingOptions_OnHide(self);
			</OnHide>
		</Scripts>
	</Frame>
</Ui>
